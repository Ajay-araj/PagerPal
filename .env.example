# PagerPal Environment Configuration
ENVIRONMENT=SIMULATION
SIMULATION_MODE=true

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Safety Policy Engine (Strictly Enforced)
REQUIRE_HUMAN_APPROVAL=true
