# PagerPal Backend Environment Configuration

# Server Environment (SIMULATION ensures safe synthetic execution)
ENVIRONMENT=SIMULATION

# Optional persistent database path (default: backend/pagerpal.db)
# On Render with persistent disk: /data/pagerpal.db
# DATABASE_PATH=/data/pagerpal.db

# Frontend CORS Origin(s) for production (comma-separated if multiple)
# e.g., https://pagerpal.vercel.app
FRONTEND_URL=https://pagerpal.vercel.app

# Optional AI / LLM Provider Key (Anthropic Claude 3.5 Sonnet)
# If omitted, PagerPal seamlessly falls back to high-fidelity deterministic incident reasoning
ANTHROPIC_API_KEY=

# Optional GitHub Integration (for autonomous postmortem issue / PR filing)
GITHUB_TOKEN=
GITHUB_REPO=

# Optional Notification Webhooks (for incident notifications & escalation)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
